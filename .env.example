# ---------------------------------------------------------------------------
# DramaBiliki Bridge — environment variables
# Local: copy to .env.  Dokploy: paste into the service's "Environment" tab.
# ---------------------------------------------------------------------------

APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# REQUIRED in production — generate with: openssl rand -hex 32
# (if left empty in production, a random key is generated and stored in DATA_DIR)
SECRET_KEY=

# REQUIRED — the default password is refused in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public HTTPS URL of the bridge (what you type in the mobile app settings)
PUBLIC_BASE_URL=https://api.example.com

# Content source
SOURCE_BASE_URL=https://dramadunyam.com
SOURCE_CDN_PRIMARY=cdn2.dramaflix.net
SOURCE_CDN_FAILOVER=cdn.dramaflix.net

# Storage (the Docker image already sets these to /app/data and /app/media)
# DATA_DIR=/app/data
# DATABASE_URL=sqlite:////app/data/dramabiliki.db
# MEDIA_DIR=/app/media
# COVERS_DIR=/app/media/covers

# Streaming
STREAM_CACHE_TTL_SECONDS=600
PROXY_SEGMENTS=false

# Background sync
ENABLE_SCHEDULER=true
LIGHT_SYNC_INTERVAL_MINUTES=30
FULL_SYNC_HOUR_UTC=3
SYNC_ON_STARTUP_IF_EMPTY=true

# Scanner politeness
SCANNER_MAX_CONCURRENT_REQUESTS=2
SCANNER_REQUEST_DELAY_MIN=0.4
SCANNER_REQUEST_DELAY_MAX=1.2
SCANNER_MAX_RETRIES=3
SCANNER_TIMEOUT_SECONDS=15.0
