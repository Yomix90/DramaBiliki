# Application settings
APP_NAME="DramaBiliki Bridge"
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=generate_a_secure_random_key_here

# Content Source (dramadunyam.com)
SOURCE_BASE_URL=https://dramadunyam.com
SOURCE_CDN_PRIMARY=cdn2.dramaflix.net
SOURCE_CDN_FAILOVER=cdn.dramaflix.net
SOURCE_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"

# Database & Storage
DATABASE_URL=sqlite:///dramabiliki.db
MEDIA_DIR=media
COVERS_DIR=media/covers

# Streaming
STREAM_CACHE_TTL_SECONDS=600
PROXY_SEGMENTS=false

# Scanner Politeness
SCANNER_MAX_CONCURRENT_REQUESTS=2
SCANNER_REQUEST_DELAY_MIN=0.4
SCANNER_REQUEST_DELAY_MAX=1.2
SCANNER_MAX_RETRIES=3
SCANNER_TIMEOUT_SECONDS=15.0

# Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DramaBiliki2026!
