# nginx in front of the DramaBiliki bridge (generated by docker/start.sh).
#   - every request is forwarded to the Python server (127.0.0.1:__APP_PORT__)
#   - videos and the APK are sent by nginx itself when Python answers with
#     "X-Accel-Redirect: /_protected/<path under the media volume>"
worker_processes auto;
pid /tmp/nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 4096;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;

    sendfile on;
    sendfile_max_chunk 512k;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;

    # Uploads (video chunks, APK, backups) are streamed to Python unchanged
    client_max_body_size 0;

    # Keep what Traefik (HTTPS) told us about the original request
    map $http_x_forwarded_proto $fwd_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    upstream bridge_app {
        server 127.0.0.1:__APP_PORT__;
        keepalive 64;
    }

    server {
        listen __PORT__ default_server;

        # Files handed over by Python (not reachable directly from outside)
        location /_protected/ {
            internal;
            alias __MEDIA_DIR__/;
            add_header Accept-Ranges bytes;
        }

        location / {
            proxy_pass http://bridge_app;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Real-IP $remote_addr;
            # Telegram videos and progress responses are streamed as they come
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
